pipeline{
     agent any

    stages {
      stage(build) {
          steps {
            sh 'mkdir -p build'
            sh 'cp app.py build/'
            echo 'application build completed'
       }
   }
        stage('test') {
           steps {
              sh 'python3 build/app.py > test-output.txt'
              sh 'grep "2=3 = 5" test-output.txt'
              echo 'test passed'
         }
    }
    stage('archive artifacts') {
           steps {
               archiveartifacts artifacts: 'build/app.ppy, test-output.txt'
                    }
                }
          }
      }

